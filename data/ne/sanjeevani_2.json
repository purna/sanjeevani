      "image": "assets/backgrounds/act2_page3.jpg"
    },
    {
      "id": "a2_3",
      "speaker": "sanjeevani",
      "text": "यो एउटा सरल, दुःखदार नदेखि एक चम्मचमा गुनगुनाउँदो हो।",
      "fx": "type",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "health_int",
      "foreground": "fg_interpreter",
