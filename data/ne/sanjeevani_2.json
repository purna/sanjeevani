      "image": "assets/backgrounds/act2_page2.jpg"
    },
    {
      "id": "a2_2",
      "speaker": "narrator",
      "text": "गर्म, निजी परामर्श — क्लिनिकल ठण्डापन बिना सुन्ने।",
      "fx": "fade",
      "delay": 850,
      "align": "center",
