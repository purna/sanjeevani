  "lines": [
    {
      "id": "a3_0",
      "speaker": "narrator",
      "text": "दिनप्रतिदिन, ताराखुराले हरेक खुराक चिन्हण गर्छ — कुनै पनि मिस गरिएन।",
      "fx": "fade",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "मधुर घण्टीको ध्वनि",
      "scene": "knowledge",
      "foreground": "fg_interpreter",
      "time": "1:05–1:10",
      "image": "assets/backgrounds/act3_page1.jpg"
    },
    {
      "id": "a3_1",
      "speaker": "narrator",
      "text": "परिवारको साथमा, उसले साँझको चियासँग औषधि खानुहुन्छ।",
      "fx": "fade",
      "delay": 850,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "चम्मचको टक्कर",
      "scene": "home_int",
      "foreground": "fg_interpreter",
      "time": "1:10–1:15",
      "image": "assets/backgrounds/act3_page2.jpg"
    },
    {
      "id": "a3_2",
      "speaker": "narrator",
      "text": "परिवारले स्वास्थ्य चौकीमा फर्कन्छ — टीबी फैल्छ, तर यसलाई रोक्न सकिन्छ।",
      "fx": "fade",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "health_int",
      "foreground": "fg_interpreter",
      "time": "1:15–1:20",
      "image": "assets/backgrounds/act3_page3.jpg"
    },
    {
      "id": "a3_3",
      "speaker": "health_worker",
      "text": "हाम्रा बालबालिका र नजदिकीका लागि बिरामी अघि नै सुरक्षा उपलब्ध गराउँछौं।",
      "fx": "type",
      "delay": 950,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "health_int",
      "foreground": "fg_interpreter",
      "time": "1:20–1:25",
      "image": "assets/backgrounds/act3_page4.jpg"
    },
    {
      "id": "a3_4",
      "speaker": "narrator",
      "text": "यहाँ कुनै अवमानना छैन — पड़ोसीहरू एक समुदायको रूपमा ठाउँ र हँसो भाडा लिन्छन्।",
      "fx": "fade",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "मुलाहटको हँसो",
      "scene": "morning",
      "foreground": "fg_interpreter",
      "time": "1:25–1:30",
      "image": "assets/backgrounds/act3_page5.jpg"
    },
    {
      "id": "a3_5",
      "speaker": "grandfather",
      "text": "मलाई आफ्ना हात र मुटुमा शक्ति फर्किएको महसुस छ।",
      "fx": "fade",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "गहिरो साँस झल्किन",
