{
  "id": "recovery",
  "name": "अध्याय ४ · सुधार र समुदाय",
  "bg": "radial-gradient(circle at 50% 25%, #3d3a2e, #2a2820 70%)",
  "particle": "dawn",
  "lines": [
    {
      "id": "a4_0",
      "speaker": "narrator",
      "text": "उसले खेतमा फर्कन्छ, बलपूर्वक कटाई गर्दै — स्वास्थ्य नै धन हो।",
      "fx": "fade",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "कुदालको फुस्कर",
      "scene": "workfield",
      "foreground": "fg_interpreter",
      "time": "1:35–1:40",
      "image": "assets/backgrounds/act4_page1.jpg"
    },
    {
      "id": "a4_1",
      "speaker": "narrator",
      "text": "पड़ोसीहरूले पारंपरिक बर्तनबाट चिया पिउँछन् — पूर्ण स्वीकृति, कुनै डर छैन।",
      "fx": "fade",
      "delay": 850,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "morning",
      "foreground": "fg_interpreter",
      "time": "1:40–1:45",
      "image": "assets/backgrounds/act4_page2.jpg"
    },
    {
      "id": "a4_2",
      "speaker": "narrator",
      "text": "पुस्ताहरू साथै — बालबालिका र वृद्धहरू, हँस्दै, सुरक्षित।",
      "fx": "fade",
      "delay": 850,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "sfx": "बालबालिकाको खेलकुद",
      "scene": "morning",
      "foreground": "fg_interpreter",
      "time": "1:45–1:50",
      "image": "assets/backgrounds/act4_page3.jpg"
    },
    {
      "id": "a4_3",
      "speaker": "narrator",
      "text": "पूरा गाउँले बिहीबारको सूर्यमा सुनौलो र हरियो चम्किन्छ।",
      "fx": "fade",
      "delay": 850,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "morning",
      "foreground": "fg_interpreter",
      "time": "1:50–1:55",
      "image": "assets/backgrounds/act4_page4.jpg"
    },
    {
      "id": "a4_4",
      "speaker": "sanjeevani",
      "text": "ज्ञान, सुरक्षा, र समुदाय — यही भनेको सबैभन्दा साँचो उपचार हो।",
      "fx": "type",
      "delay": 900,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "morning",
      "foreground": "fg_interpreter",
      "time": "1:55–2:00",
      "image": "assets/backgrounds/act4_page5.jpg"
    },
    {
      "id": "a4_5",
      "speaker": "narrator",
      "text": "कथा अन्ततर्फ झर्छ, एउटा स्पष्ट कार्य कारणमा गाइन्दै।",
      "fx": "fade",
      "delay": 1000,
      "align": "center",
      "width": "1/2",
      "valign": "middle",
      "scene": "end",
      "foreground": "fg_interpreter",
      "time": "2:00–2:05",
      "image": "assets/backgrounds/act4_page6.jpg"
    }
  ],
  "svg": "recovery",
  "scene": "recovery",
